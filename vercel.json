{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/img", "destination": "/api/img.js" },
    { "source": "/image-proxy", "destination": "/api/img.js" },
    { "source": "/api/checkout", "destination": "/api/checkout.js" },
    { "source": "/api/payment-done", "destination": "/api/payment-done.js" },
    { "source": "/api/admin", "destination": "/api/admin.js" }
  ]
}
