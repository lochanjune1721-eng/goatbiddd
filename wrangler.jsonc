{
  // Committed so the deploy is deterministic rather than relying on the
  // settings wrangler infers on the build machine.
  "name": "goatbiddd",
  "compatibility_date": "2026-08-28",
  "observability": { "enabled": true },

  // The site is served from the repo root; .assetsignore decides what of it
  // actually ships. Note there is no "main" here: this deploys the static
  // site only. The /api/* routes are Vercel-style Node functions and do not
  // run on Workers — see the note in README.
  "assets": { "directory": "." }
}
