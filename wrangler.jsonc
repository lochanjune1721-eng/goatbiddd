{
  // Committed so the deploy is deterministic rather than relying on the
  // settings wrangler infers on the build machine.
  "name": "goatbiddd",
  "main": "worker.js",
  "compatibility_date": "2026-08-28",

  // The API handlers use node:crypto, Buffer and process.env.
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Plaintext configuration, not secrets — the rupee price of a vote and the
  // name that shows in a payer's UPI app are both public the moment a checkout
  // opens. Declaring them here means they deploy with the code, are reviewable
  // in a diff, and cannot go missing because someone forgot a dashboard step.
  //
  // This is also the correct home for them for a mechanical reason: `wrangler
  // deploy` treats this file as the source of truth for plaintext vars, so any
  // set only in the dashboard are wiped on the next deploy. Secrets are
  // encrypted and unaffected — API keys and ADMIN_PASSWORD stay there, and a
  // dashboard Secret of the same name still overrides anything below.
  //
  // Change INR_PER_VOTE here to reprice the Indian rails; both read it.
  "vars": {
    // Live. Every rail whose secrets are set will take real money, and the
    // dollars on the boards are meant to be the dollars people paid.
    //
    // Turning this off is only half of going live. The other half is the
    // database, which no deploy touches: seeded backing left in place with the
    // rails open puts real payers in front of $192,764 nobody paid, on a site
    // whose rules page says every dollar on a board is one somebody actually
    // put down. data/go-live-check.sql answers whether that has been cleared —
    // run it before trusting this flag.
    //
    // Set back to "1" to close the rails again. It is enforced in the payment
    // handlers, not only in the UI, so a hand-made POST is refused the same as
    // a button.
    "DEMO_MODE": "0",

    "INR_PER_VOTE": "60",
    "UPI_PAYEE_NAME": "The True GOAT",
    // The apex, not www. www.thetruegoat.com has no DNS record — it answers
    // NXDOMAIN, while thetruegoat.com resolves to Cloudflare and serves the
    // site. This value is where a payer is sent back to after paying, so
    // pointing it at a hostname that does not exist strands them on a browser
    // error holding a completed payment.
    //
    // If www is meant to be the canonical name, add the DNS record for it in
    // Cloudflare and change this back — the record has to exist first either
    // way.
    "SITE_URL": "https://thetruegoat.com"
  },

  // public/ is assembled by scripts/build-assets.mjs and holds only what the
  // browser fetches — so node_modules can never be swept into the upload.
  // The Worker handles /api/* and hands everything else to ASSETS, whose
  // html_handling serves /about from about.html, so the clean URLs survive.
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  }
}
