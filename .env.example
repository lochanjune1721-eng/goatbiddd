# Copy to .env and fill in. Never commit the real file.
# The values that used to sit here were live keys, not placeholders.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Public by design — this one also ships in js/supabase.js.
SUPABASE_ANON_KEY=eyJ...anon-key...
# Bypasses row-level security. Server and scripts only, never the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...
# Only needed by fast_copy.mjs / copy_imgs.mjs, which migrate from the old project.
OLD_SUPABASE_SERVICE_ROLE_KEY=

# ── PayPal ──────────────────────────────────────────────────────────────────
# From developer.paypal.com. Client id and secret are per-environment: live
# credentials do not work against sandbox or vice versa.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id of the webhook pointing at /api/payment-done. Without it the webhook
# refuses to credit a wallet rather than trusting an unverified caller.
PAYPAL_WEBHOOK_ID=
# "sandbox" to test; anything else (or unset) means live.
PAYPAL_ENV=

# ── UroPay (UPI, India) ─────────────────────────────────────────────────────
# Optional second rail alongside PayPal. Which environment a request hits is
# decided by which key signs it — there is no environment setting. TEST needs
# no KYC; PRODUCTION is refused with 403 until the account clears review.
UROPAY_API_KEY=
UROPAY_API_SECRET=
# ── Direct UPI (pay straight to your own VPA) ───────────────────────────────
# No gateway, no fees — and no callback, so nothing can tell the server the
# money arrived. Payers submit their UTR and you approve it in /admin against
# your bank statement. Leave blank to hide the UPI option entirely.
UPI_VPA=yourname@okhdfcbank
UPI_PAYEE_NAME=The True GOAT

# Rupee price of one vote, shared by both Indian rails. No default: they refuse
# rather than invent an exchange rate. e.g. 90 means 1 vote costs INR 90.
INR_PER_VOTE=

# ── Site ────────────────────────────────────────────────────────────────────
SITE_URL=https://www.thetruegoat.com
ADMIN_PASSWORD=choose-one
# Shared secret for /api/resolve_image, a maintenance route that writes photos.
RESOLVER_SECRET=
