# Copy to .env and fill in. Never commit the real file.
# The values that used to sit here were live keys, not placeholders.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Public by design — this one also ships in js/supabase.js.
SUPABASE_ANON_KEY=eyJ...anon-key...
# Bypasses row-level security. Server and scripts only, never the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...
# Only needed by fast_copy.mjs / copy_imgs.mjs, which migrate from the old project.
OLD_SUPABASE_SERVICE_ROLE_KEY=

# ── PayPal ──────────────────────────────────────────────────────────────────
# From developer.paypal.com. Client id and secret are per-environment: live
# credentials do not work against sandbox or vice versa.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id of the webhook pointing at /api/payment-done. Without it the webhook
# refuses to credit a wallet rather than trusting an unverified caller.
PAYPAL_WEBHOOK_ID=
# "sandbox" to test; anything else (or unset) means live.
PAYPAL_ENV=

# ── Site ────────────────────────────────────────────────────────────────────
SITE_URL=https://www.thetruegoat.com
ADMIN_PASSWORD=choose-one
# Shared secret for /api/resolve_image, a maintenance route that writes photos.
RESOLVER_SECRET=
